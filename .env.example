# Copiar para .env e preencher. NUNCA fazer commit do .env real.

# --- Transcrição (opcional; sem chave, usa faster-whisper local se instalado) ---
OPENAI_API_KEY=

# --- Análise da história, roteiro e SEO (obrigatório para o pipeline completo) ---
ANTHROPIC_API_KEY=

# --- Narração / Text-to-Speech ---
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Publicação no YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Preferências gerais ---
MOVIE_SUMMARY_LANGUAGE=pt-PT
MOVIE_SUMMARY_DEFAULT_PRIVACY=private
