<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <ImageView
            android:id="@+id/login_logo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="36dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/login_title" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/login_subtitle" />

        <TextView
            android:id="@+id/login_message"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_warning_box"
            android:padding="14dp"
            android:visibility="gone" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/label_email" />

            <EditText
                android:id="@+id/login_email"
                style="@style/Input"
                android:autofillHints="emailAddress"
                android:drawableStart="@drawable/ic_email"
                android:drawableTint="@color/text_muted"
                android:hint="@string/hint_email"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_password" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/login_password"
                    style="@style/Input"
                    android:autofillHints="password"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawableTint="@color/text_muted"
                    android:hint="@string/hint_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingEnd="52dp" />

                <ImageButton
                    android:id="@+id/login_toggle_password"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_ripple_circle"
                    android:contentDescription="@string/cd_toggle_password"
                    android:src="@drawable/ic_visibility"
                    android:tint="@color/text_muted" />
            </FrameLayout>

            <TextView
                android:id="@+id/login_forgot"
                style="@style/Button.Text"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/login_forgot" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/login_submit"
                    style="@style/Button.Primary"
                    android:text="@string/login_submit" />

                <ProgressBar
                    android:id="@+id/login_progress"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:elevation="8dp"
                    android:indeterminateTint="@color/text_primary"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account" />

            <TextView
                android:id="@+id/login_register"
                style="@style/Button.Text"
                android:gravity="center"
                android:text="@string/login_register"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
