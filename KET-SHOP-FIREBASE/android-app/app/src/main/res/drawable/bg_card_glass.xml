<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism moderado: fundo translúcido + contorno neon suave -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <gradient android:angle="135" android:startColor="#22FFFFFF" android:endColor="#0AFFFFFF" />
            <stroke android:width="1dp" android:color="@color/ks_glass_stroke" />
        </shape>
    </item>
</layer-list>
