<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <include layout="@layout/view_state" />

    <ScrollView
        android:id="@+id/proof_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Formulário de envio -->
            <LinearLayout
                android:id="@+id/proof_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/proof_order_code"
                        style="@style/Text.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/proof_order_info"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/proof_rejected"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_error_box"
                    android:padding="14dp"
                    android:visibility="gone" />

                <TextView
                    style="@style/Text.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/proof_title" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/proof_subtitle" />

                <!-- Área de pré-visualização -->
                <FrameLayout
                    android:id="@+id/proof_preview_box"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_image_placeholder"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:id="@+id/proof_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/proof_tap_to_choose"
                            android:src="@drawable/ic_upload"
                            android:tint="@color/ks_neon_light" />

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/proof_tap_to_choose"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/proof_formats" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/proof_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="6dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/cd_proof_preview"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/proof_remove"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_circle_neon"
                        android:contentDescription="@string/proof_remove"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close"
                        android:tint="@color/text_primary"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/proof_preparing"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/ks_neon"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/proof_file_info"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/proof_source_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/proof_gallery"
                        style="@style/Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_image"
                        android:drawableTint="@color/ks_neon_light"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/proof_from_gallery" />

                    <Button
                        android:id="@+id/proof_camera"
                        style="@style/Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_camera"
                        android:drawableTint="@color/ks_neon_light"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/proof_from_camera" />
                </LinearLayout>

                <Button
                    android:id="@+id/proof_replace"
                    style="@style/Button.Outline"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/proof_replace"
                    android:visibility="gone" />

                <!-- Progresso do envio -->
                <LinearLayout
                    android:id="@+id/proof_progress_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/proof_progress"
                        style="@android:style/Widget.Material.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:max="100"
                        android:progressDrawable="@drawable/progress_neon" />

                    <TextView
                        android:id="@+id/proof_progress_text"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />
                </LinearLayout>

                <TextView
                    android:id="@+id/proof_error"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_error_box"
                    android:padding="14dp"
                    android:visibility="gone" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawableStart="@drawable/ic_shield"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/status_success"
                    android:text="@string/proof_privacy" />
            </LinearLayout>

            <!-- Sucesso -->
            <LinearLayout
                android:id="@+id/proof_success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/proof_success_icon"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:contentDescription="@string/proof_success_title"
                    android:src="@drawable/ic_check_circle"
                    android:tint="@color/status_success" />

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/proof_success_title" />

                <TextView
                    android:id="@+id/proof_success_text"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/proof_success_track"
                    style="@style/Button.Primary"
                    android:layout_marginTop="28dp"
                    android:text="@string/proof_success_track" />

                <Button
                    android:id="@+id/proof_success_home"
                    style="@style/Button.Outline"
                    android:layout_marginTop="12dp"
                    android:text="@string/proof_success_home" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/proof_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:padding="16dp">

        <Button
            android:id="@+id/proof_submit"
            style="@style/Button.Primary"
            android:enabled="false"
            android:text="@string/proof_submit" />
    </LinearLayout>
</LinearLayout>
