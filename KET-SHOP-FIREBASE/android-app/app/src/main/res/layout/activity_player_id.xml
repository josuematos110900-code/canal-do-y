<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/player_product_icon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_product_icon"
                    android:contentDescription="@string/cd_product_icon"
                    android:padding="10dp"
                    android:src="@drawable/ic_diamond"
                    android:tint="@color/ks_neon_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/player_product_name"
                        style="@style/Text.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/player_product_price"
                        style="@style/Text.Price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/player_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/player_subtitle" />

            <Button
                android:id="@+id/player_use_saved"
                style="@style/Button.Outline"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_player_id" />

            <EditText
                android:id="@+id/player_id"
                style="@style/Input"
                android:digits="0123456789"
                android:drawableStart="@drawable/ic_gamepad"
                android:drawableTint="@color/text_muted"
                android:hint="@string/hint_player_id"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="15" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_player_id_confirm" />

            <EditText
                android:id="@+id/player_id_confirm"
                style="@style/Input"
                android:digits="0123456789"
                android:drawableStart="@drawable/ic_gamepad"
                android:drawableTint="@color/text_muted"
                android:hint="@string/hint_player_id_confirm"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="15" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_nickname" />

            <EditText
                android:id="@+id/player_nickname"
                style="@style/Input"
                android:drawableStart="@drawable/ic_person"
                android:drawableTint="@color/text_muted"
                android:hint="@string/hint_nickname"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLength="40" />

            <CheckBox
                android:id="@+id/player_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/ks_neon"
                android:checked="true"
                android:text="@string/player_save_id"
                android:textColor="@color/text_secondary" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_solid"
                android:drawableStart="@drawable/ic_info"
                android:drawablePadding="10dp"
                android:drawableTint="@color/status_info"
                android:padding="14dp"
                android:text="@string/player_help"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:padding="16dp">

        <Button
            android:id="@+id/player_continue"
            style="@style/Button.Primary"
            android:text="@string/action_continue" />
    </LinearLayout>
</LinearLayout>
