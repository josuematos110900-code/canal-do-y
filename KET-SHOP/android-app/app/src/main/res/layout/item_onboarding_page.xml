<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <ImageView
        android:id="@+id/onboarding_page_icon"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_product_icon"
        android:contentDescription="@string/cd_onboarding_icon"
        android:padding="34dp"
        android:tint="@color/ks_neon_light" />

    <TextView
        android:id="@+id/onboarding_page_title"
        style="@style/Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/onboarding_page_text"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:maxWidth="420dp" />
</LinearLayout>
