<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/register_subtitle" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_full_name" />

            <EditText
                android:id="@+id/register_name"
                style="@style/Input"
            android:autofillHints="name"
                android:drawableStart="@drawable/ic_person"
                android:drawableTint="@color/text_muted"
                android:hint="@string/hint_full_name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_phone" />

            <EditText
                android:id="@+id/register_phone"
                style="@style/Input"
            android:autofillHints="phone"
                android:drawableStart="@drawable/ic_phone"
                android:drawableTint="@color/text_muted"
                android:hint="@string/hint_phone"
                android:imeOptions="actionNext"
                android:inputType="phone" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_email" />

            <EditText
                android:id="@+id/register_email"
                style="@style/Input"
            android:autofillHints="emailAddress"
                android:drawableStart="@drawable/ic_email"
                android:drawableTint="@color/text_muted"
                android:hint="@string/hint_email"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_password" />

            <EditText
                android:id="@+id/register_password"
                style="@style/Input"
            android:autofillHints="newPassword"
                android:drawableStart="@drawable/ic_lock"
                android:drawableTint="@color/text_muted"
                android:hint="@string/hint_new_password"
                android:imeOptions="actionNext"
                android:inputType="textPassword" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_password_confirm" />

            <EditText
                android:id="@+id/register_password_confirm"
                style="@style/Input"
                android:drawableStart="@drawable/ic_lock"
                android:drawableTint="@color/text_muted"
                android:hint="@string/hint_password_confirm"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/register_password_rules" />

            <CheckBox
                android:id="@+id/register_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:buttonTint="@color/ks_neon"
                android:text="@string/register_accept_terms"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/register_terms_link"
                    style="@style/Button.Text"
                    android:gravity="center"
                    android:text="@string/terms_title" />

                <TextView
                    android:id="@+id/register_privacy_link"
                    style="@style/Button.Text"
                    android:gravity="center"
                    android:text="@string/privacy_title" />
            </LinearLayout>

            <TextView
                android:id="@+id/register_message"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_error_box"
                android:padding="14dp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <Button
                    android:id="@+id/register_submit"
                    style="@style/Button.Primary"
                    android:text="@string/register_submit" />

                <ProgressBar
                    android:id="@+id/register_progress"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:elevation="8dp"
                    android:indeterminateTint="@color/text_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/register_login"
                style="@style/Button.Text"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/register_have_account" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
